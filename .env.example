# CyberSecure Password Manager - Environment Variables Configuration
# Copy this file to .env and fill in with your actual values
# NEVER commit the .env file to version control

# ========== FLASK CONFIGURATION ==========
# Set to 'production' for production deployments
FLASK_ENV=development
FLASK_DEBUG=False

# Generate a strong secret key for production
# You can generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=your-super-secret-key-here-change-in-production

# ========== ENCRYPTION CONFIGURATION ==========
# Set your Fernet encryption key here (must be a valid base64-encoded key)
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=6V4m1m7V9z0WgY3M5oYt6z1V4n8m2K5jL0pQxR7sT8U=

# ========== DATABASE CONFIGURATION ==========
# For local development: SQLite (no need to set DATABASE_URL)
# For production on Render: Use PostgreSQL connection string
# Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/cybersecure

# ========== PORT CONFIGURATION ==========
# Port to run the application on (default: 5000 for development, 8000 for production)
# Render automatically sets PORT environment variable
PORT=5000

# ========== SECURITY ==========
# For production deployments, set these to enforce security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
